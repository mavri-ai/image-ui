{
  "name": "image-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run registry:build",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/build-registry.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "registry:build": "node scripts/build-registry.mjs",
    "format:check": "prettier --check src scripts tests index.html package.json tsconfig.json vite.config.ts playwright.config.ts README.md"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
